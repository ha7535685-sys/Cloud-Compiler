# Server Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Sandbox Runner (Piston)
# Local docker-compose service default: http://localhost:2000/api/v2
# Public fallback (if docker is not running locally): https://emkc.org/api/v2/piston
PISTON_API_URL=http://localhost:2000/api/v2
FALLBACK_PISTON_API_URL=https://emkc.org/api/v2/piston

# Database Configuration (SQLite for local dev, Postgres connection string for production)
DATABASE_URL=file:./dev.db

# AI Assistance Configuration
# Supported providers: gemini | openai | anthropic
AI_PROVIDER=gemini
AI_API_KEY=your_api_key_here
AI_MODEL=gemini-1.5-flash

# Security & Limits
RATE_LIMIT_RUNS_PER_MIN=20
RATE_LIMIT_AI_PER_MIN=10
MAX_CODE_SIZE_BYTES=65536
EXECUTION_TIMEOUT_MS=10000
MAX_OUTPUT_SIZE_BYTES=102400
